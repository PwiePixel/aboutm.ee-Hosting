# Kopiere diese Datei nach .env und trage deine Werte ein — oder nimm einfach install.sh.

# ── Adressen ─────────────────────────────────────────────────────────────
# Domain der Website (ohne https://).
SITE_DOMAIN=aboutm.ee
# Öffentliche Adresse der Website (mit https://, ohne Slash am Ende).
SITE_URL=https://aboutm.ee
# Welten heißen mc-xxxx.<SERVER_DOMAIN>.
SERVER_DOMAIN=aboutm.ee
# Adresse dieses Servers für Minecraft (A-Eintrag auf seine IP, bei Cloudflare OHNE Proxy / graue Wolke).
NODE_HOST=node.aboutm.ee
# Aus diesem Bereich bekommt jede Welt ihren festen Port. In der Firewall freigeben.
MC_PORT_MIN=25600
MC_PORT_MAX=26599

# ── Cloudflare: eigene Adresse je Welt ───────────────────────────────────
# Mit diesem Zugang legt die Website für jede Welt einen SRV-Eintrag an und löscht ihn wieder.
# Token: Cloudflare-Dashboard -> Mein Profil -> API-Token, Berechtigung "Zone · DNS · Bearbeiten" für die Domain.
# Zonen-ID: steht auf der Übersichtsseite der Domain rechts unten.
# Ohne diese beiden Werte verbinden sich Spieler über <NODE_HOST>:<Port>.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=

# ── Cloudflare Turnstile (Sicherheitsprüfung bei Login, Registrierung, Hilfe) ──
# Cloudflare-Dashboard -> Turnstile -> Widget hinzufügen -> beide Schlüssel hier eintragen.
# Ohne Schlüssel bleiben die Formulare im Live-Betrieb gesperrt.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Betrieb ──────────────────────────────────────────────────────────────
# Zertifikat des Servers: internal (hinter Cloudflare) oder eine E-Mail-Adresse für Let's Encrypt.
CADDY_TLS=internal
# Wo Datenbank, Weltdateien, Backups und hochgeladene Bilder liegen (Pfad auf dem Server).
DATA_PATH=/srv/aboutmee/data
# Startwerte — danach im Admin-Bereich änderbar.
TOTAL_SLOTS=20
AUTO_PAUSE_MINUTES=30
# Höchstens so viele CPU-Kerne je Welt.
MC_CPUS=2
# Kontaktadresse auf der Hilfe-Seite (optional).
SUPPORT_EMAIL=

# ── Optional: Statistik mit Einwilligung (Banner erscheint nur, wenn gesetzt) ──
UMAMI_SRC=
UMAMI_WEBSITE_ID=
CF_BEACON_TOKEN=
