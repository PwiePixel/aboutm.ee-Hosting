# HTTPS für die Website.
#
# Die Website liegt hinter Cloudflare (orange Wolke). Das öffentliche Zertifikat stellt Cloudflare;
# dieser Server braucht für die Strecke von Cloudflare hierher nur irgendein Zertifikat. Deshalb
# erzeugt Caddy standardmäßig selbst eines (CADDY_TLS=internal) — das klappt immer und passt zu den
# Cloudflare-Modi „Flexible“ und „Full“.
# Für „Full (strict)“ oder einen Betrieb ohne Cloudflare-Proxy: in .env CADDY_TLS=<deine E-Mail>
# setzen. Dann holt Caddy ein öffentlich gültiges Zertifikat von Let's Encrypt.
{
	# Caddys eigene Weiterleitung von HTTP auf HTTPS ist aus: Im Modus „Flexible“ spricht Cloudflare
	# diesen Server unverschlüsselt an und geriete sonst in eine Endlosschleife. Stattdessen leitet der
	# Block für http:// weiter unten nur Besucher um, die selbst unverschlüsselt gekommen sind.
	auto_https disable_redirects
	servers {
		# Anfragen kommen über Cloudflare. Nur dessen Servern wird geglaubt, wer der eigentliche
		# Besucher ist — wer den Server direkt anspricht, kann sich keine fremde Adresse geben.
		# Bereiche: https://www.cloudflare.com/ips/ (Stand 20.11.2026); install.sh trägt die aktuellen
		# in CLOUDFLARE_IPS ein.
		trusted_proxies static {$CLOUDFLARE_IPS:173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32}
		client_ip_headers CF-Connecting-IP
	}
}

(website) {
	# Wer darf diesen Server überhaupt ansprechen? Läuft die Website über Cloudflare, trägt install.sh
	# hier dessen Adressbereiche ein (ORIGIN_ALLOW). Wer den Server dann direkt anspricht — an Cloudflare
	# und dessen Schutz vorbei —, bekommt keine Antwort. Ohne Angabe darf jeder.
	@direct not remote_ip {$ORIGIN_ALLOW:0.0.0.0/0 ::/0}
	abort @direct

	encode zstd gzip
	reverse_proxy web:3000 {
		# Die geprüfte Adresse weitergeben; die ungeprüfte Angabe des Besuchers entfernen.
		header_up X-Real-IP {client_ip}
		header_up -CF-Connecting-IP
	}
}

https://{$SITE_DOMAIN} {
	tls {$CADDY_TLS:internal}
	import website
}

http://{$SITE_DOMAIN} {
	# Unverschlüsselt gekommene Besucher auf HTTPS umleiten — sonst gingen Passwörter im Klartext durchs
	# Netz, und die Anmeldung klappte ohnehin nicht (das Sitzungs-Cookie gilt nur über HTTPS).
	# Im Modus „Flexible“ kommt die Anfrage von Cloudflare zwar unverschlüsselt hier an, der Besucher war
	# aber über HTTPS da; das meldet Cloudflare mit X-Forwarded-Proto: https, und es wird nicht umgeleitet.
	# Umgeleitet wird nur, wer den Server überhaupt ansprechen darf — alle anderen bekommen auch hier keine Antwort.
	@plain {
		remote_ip {$ORIGIN_ALLOW:0.0.0.0/0 ::/0}
		not header X-Forwarded-Proto https
	}
	redir @plain https://{host}{uri} 308
	import website
}
